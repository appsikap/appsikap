			<td>Fase / Kelas / Semester</td>
			<td>C / 5 (Lima) / Ganjil</td>
		</tr>
		<tr>
			<td>Mata Pelajaran</td>
			<td>Ilmu Pengetahuan Alam dan Sosial (IPAS)</td>
