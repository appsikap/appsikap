  <!-- INSTRUMEN PENILAIAN -->
  <h3>B. INSTRUMEN PENILAIAN (RUBRIK KINERJA PRAKTIKUM)</h3>
  <table>
    <thead>
      <tr>
        <th>Kriteria</th>
        <th>Sangat Baik (4)</th>
        <th>Baik (3)</th>
        <th>Cukup (2)</th>
        <th>Perlu Bimbingan (1)</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Persiapan Alat</td>
        <td>Membawa dan menyiapkan alat dengan sangat lengkap dan rapi.</td>
        <td>Menyiapkan alat dengan lengkap.</td>
        <td>Alat kurang lengkap namun bisa mengikuti kegiatan.</td>
        <td>Tidak menyiapkan alat.</td>
      </tr>
      <tr>
        <td>Ketepatan Analisis</td>
        <td>Mampu menjelaskan 5 sifat cahaya dengan tepat dan logis.</td>
        <td>Mampu menjelaskan 3-4 sifat cahaya dengan tepat.</td>
        <td>Hanya mampu menjelaskan 1-2 sifat cahaya.</td>
        <td>Belum mampu menjelaskan sifat cahaya.</td>
      </tr>
      <tr>
        <td>Kerjasama Tim</td>
        <td>Sangat aktif berkontribusi dan menghargai pendapat teman.</td>
        <td>Aktif berkontribusi dalam kelompok.</td>
        <td>Hanya sesekali membantu anggota kelompok.</td>
        <td>Pasif atau mengganggu kelompok lain.</td>
      </tr>
    </tbody>
  </table>

