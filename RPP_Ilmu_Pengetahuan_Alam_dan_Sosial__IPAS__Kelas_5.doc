<body>
  <!-- HEADER JUDUL -->
  <div style="text-align: center; margin-bottom: 30px;">
    <h2 style="margin: 0; font-size: 16pt;">RENCANA PEMBELAJARAN MENDALAM (MODUL AJAR)</h2>
    <h3 style="margin: 0; font-size: 14pt;">IPAS KELAS 5 - FASE C</h3>
    <h4 style="margin: 0; font-size: 12pt;">BAB 2: HARMONI DALAM EKOSISTEM (TOPIK: CAHAYA DAN MATA)</h4>
  </div>

