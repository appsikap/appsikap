			<th>Fase / Kelas</th>
			<td>Fase C / Kelas 5</td>
		</tr>
		<tr>
			<th>Mata Pelajaran</th>
			<td>Ilmu Pengetahuan Alam dan Sosial (IPAS)</td>
			<th>Materi Pokok</th>
			<td>Keanekaragaman Hayati</td>
		</tr>
		<tr>
			<th>Alokasi Waktu</th>
			<td>8 JP (3 Pertemuan)</td>
			<th>Semester</th>
			<td>1 (Ganjil)</td>
