  <title>Rencana Pembelajaran Mendalam</title>
  <style>
    @page { size: A4 portrait; margin: 2.5cm; }
    body { font-family: 'Times New Roman', Times, serif; font-size: 11pt; line-height: 1.5; color: #000; }
    h2, h3, h4 { font-family: 'Times New Roman', Times, serif; margin-bottom: 10px; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 20px; table-layout: fixed; word-wrap: break-word; }
    th, td { border: 1px solid #000; padding: 8px; vertical-align: top; text-align: left; }
    th { background-color: #f2f2f2; font-weight: bold; text-align: center; }
    ol, ul { margin-top: 5px; margin-bottom: 5px; padding-left: 25px; }
    li { margin-bottom: 8px; }
    .section-title { background-color: #e6e6e6; padding: 5px; font-weight: bold; border: 1px solid #000; margin-top: 20px; text-transform: uppercase; }
    .sub-section { font-weight: bold; text-decoration: underline; margin-top: 15px; margin-bottom: 5px; display: block; }
    .signature-container { margin-top: 50px; width: 100%; }
    .signature-box { width: 45%; display: inline-block; text-align: center; }
    .underline { text-decoration: underline; }
  </style>
</head>
<body>
  <div style="text-align: center; margin-bottom: 30px;">
    <h2 style="margin: 0; font-size: 16pt;">RENCANA PEMBELAJARAN MENDALAM (MODUL AJAR)</h2>
    <h3 style="margin: 0; font-size: 14pt; text-transform: uppercase;">ILMU PENGETAHUAN ALAM TINGKAT SMP/MTs KELAS 9 SEMESTER GANJIL</h3>
    <h4 style="margin: 0; font-size: 12pt;">TAHUN AJARAN 2026/2027</h4>
  </div>

  <div class="section-title">1. INFORMASI UMUM</div>
  
  <span class="sub-section">A. Identitas Modul</span>
