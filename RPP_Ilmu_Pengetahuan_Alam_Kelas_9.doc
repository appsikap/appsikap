      <td>SD Negeri 1 Nusantara</td>
    </tr>
    <tr>
      <td>Fase / Kelas</td>
      <td>C / 9 (Sembilan)</td>
    </tr>
    <tr>
      <td>Mata Pelajaran</td>
      <td>Ilmu Pengetahuan Alam (IPA)</td>
    </tr>
    <tr>
      <td>Bab / Topik</td>
      <td>Bab 8 / Keanekaragaman Gen</td>
    </tr>
    <tr>
      <td>Alokasi Waktu</td>
      <td>8 JP (320 Menit) - Terbagi dalam 3 Pertemuan</td>
    </tr>
